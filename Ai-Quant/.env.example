# Bull-Run Environment Configuration
# Copy this to .env and fill in your actual credentials
# NEVER commit .env to version control

# OANDA v20 API Credentials
OANDA_ACCOUNT_ID=YOUR_ACCOUNT_ID_HERE
OANDA_ACCESS_TOKEN=YOUR_API_TOKEN_HERE
OANDA_BASE_URL=https://api-fxpractice.oanda.com/v3

# Telegram Bot (for alerts)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# Database
DATABASE_PATH=./trading.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/trading.log

# Trading Configuration
TRADING_PAIRS=EUR_USD,GBP_USD,USD_JPY,AUD_USD,USD_CAD
RUN_HOUR_UTC=22
DEMO_MODE=true
